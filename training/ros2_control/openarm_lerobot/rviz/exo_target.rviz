Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 0.2
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/RobotModel
      Name: Exoskeleton Mapped Target (NOT Actual State)
      Enabled: true
      Value: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /exo_target_view/robot_description
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: ""
      Update Interval: 0
  Enabled: true
  Global Options:
    Background Color: 40; 44; 52
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.4
      Focal Point:
        X: 0
        Y: 0
        Z: 0.4
      Pitch: 0.33
      Yaw: 5.5
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1200
  Height: 850
