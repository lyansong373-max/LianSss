<?xml version="1.0" encoding="UTF-8" ?>
<!-- Scoped to the enable-and-zero process tree. No QoS, history or limits changes.
     Fast DDS 2.6 supports this explicit UDP-only transport configuration. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>openarm_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="openarm_udp_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>openarm_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
