+class LanguageConditionedFiLM(nn.Module):
+    """Modulate image tokens with a pooled instruction embedding.
+
+    The final layer starts at zero, so enabling FiLM preserves a pretrained
+    policy's predictions until the new conditioning weights are trained.
+    """
+
+    def __init__(self, width: int, hidden_dim: int):
+        super().__init__()
+        self.generator = nn.Sequential(
+            nn.Linear(width, hidden_dim),
+            nn.GELU(),
+            nn.Linear(hidden_dim, 2 * width),
+        )
+        nn.init.zeros_(self.generator[-1].weight)
+        nn.init.zeros_(self.generator[-1].bias)
+
+    def forward(
+        self, language_tokens: Tensor, language_mask: Tensor
+    ) -> tuple[Tensor, Tensor]:
+        mask = language_mask.to(dtype=torch.float32).unsqueeze(-1)
+        pooled = (language_tokens.float() * mask).sum(dim=1) / mask.sum(dim=1).clamp_min(1)
+        scale, shift = self.generator(pooled).chunk(2, dim=-1)
+        return scale, shift
+
+
+def drop_projected_state(state_embedding: Tensor, probability: float, training: bool) -> Tensor:
+    """Hide the entire proprioception token for selected training samples."""
+    if not training or probability == 0:
+        return state_embedding
+    keep = torch.rand(state_embedding.shape[0], device=state_embedding.device) >= probability
+    return state_embedding * keep[:, None].to(dtype=state_embedding.dtype)
+
+
+def normalized_state_noise_std(
+    state_std: Tensor, state_names: Sequence[str], arm_std_rad: float, gripper_std: float
+) -> Tensor:
+    """Convert noise in raw joint/gripper units to MEAN_STD-normalized units."""
+    if state_std.ndim != 1 or len(state_names) != state_std.numel():
+        raise ValueError("State noise needs one joint name and one dataset std per state dimension")
+    if not torch.isfinite(state_std).all() or (state_std <= 1e-6).any():
+        raise ValueError("State noise requires finite, positive dataset std for every state dimension")
+    raw_std = torch.tensor(
+        [gripper_std if "gripper" in name.lower() else arm_std_rad for name in state_names],
+        device=state_std.device,
+        dtype=state_std.dtype,
+    )
+    return raw_std / (state_std + 1e-8)
+
